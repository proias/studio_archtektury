# Default local development: no GitHub credentials required.
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=local

# Cloud (hosted Builds): set storage kind to cloud after connecting the project.
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=architektura/cywinska-studio

# Netlify production: set github and the repository connected to the site.
# NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=github
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=proias/studio_archtektury
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Private; configure in Netlify Builds + Functions. Never prefix with NEXT_PUBLIC_.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=

# Indexing stays off until separately approved; only effective in Netlify production.
SITE_INDEXING_ENABLED=false
# Set by netlify.toml during hosted builds; keep false for ordinary next dev.
NEXT_PUBLIC_CONTACT_ENABLED=false
